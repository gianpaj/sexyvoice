  },
  "components": {
    "schemas": {
      "VoiceGenerationRequest": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "description": "The text to synthesize (max 1000 chars for gpro/gpro31/gpro38/xai, 500 for orpheus)"
          },
          "model": {
            "description": "The voice model to use when selecting a voice by name. Omit when using voiceId.",
            "type": "string",
            "enum": [
              "gpro",
              "gpro31",
              "gpro38",
              "orpheus",
              "xai"
            ]
          },
          "response_format": {
            "description": "Audio format. Default depends on model",
            "type": "string",
            "enum": [
              "wav",
              "mp3"
            ]
          },
          "seed": {
            "description": "Optional deterministic seed for providers that support it (e.g. Gemini)",
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "speed": {
            "description": "Speech speed multiplier for Grok (xai) voices. Range 0.7-1.5. Ignored by other models.",
            "type": "number",
            "minimum": 0.7,
            "maximum": 1.5
          },
          "style": {
            "description": "Emotion/style variant (e.g., \"happy\", \"sad\", \"whisper\")",
            "type": "string"
          },
          "temperature": {
            "description": "Sampling temperature for Gemini voices (gpro/gpro31/gpro38). Range 0-2; higher is more expressive. Ignored by other models.",
            "type": "number",
            "minimum": 0,
            "maximum": 2
          },
          "voice": {
            "description": "Voice name. Use with model, or pass voiceId instead. See GET /api/v1/voices for available voices.",
            "type": "string",
            "minLength": 1
          },
          "voiceId": {
            "description": "Voice ID from GET /api/v1/voices. Use instead of voice + model.",
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "input"
        ],
        "additionalProperties": false
      },
      "BillingResponse": {
        "type": "object",
        "properties": {
          "creditsLeft": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "lastBillingTransaction": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "amount": {
                    "type": "number"
                  },
                  "created_at": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  },
                  "metadata": {
                    "anyOf": [
                      {},
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "reference_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "subscription_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "purchase",
                      "topup"
                    ]
                  }
                },
                "required": [
                  "amount",
                  "created_at",
                  "description",
                  "id",
                  "reference_id",
                  "subscription_id",
                  "type"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "lastUpdated": {
            "type": [
              "string",
              "null"
            ]
          },
          "userId": {
            "type": "string"
          }
        },
        "required": [
          "creditsLeft",
          "lastBillingTransaction",
          "lastUpdated",
          "userId"
        ],
        "additionalProperties": false
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "Machine-readable error code"
              },
              "message": {
                "type": "string",
                "description": "Human-readable error description"
              },
              "param": {
                "description": "The parameter that caused the error, if applicable",
                "type": [
                  "string",
                  "null"
                ]
              },
              "type": {
                "type": "string",
                "enum": [
                  "invalid_request_error",
                  "authentication_error",
                  "permission_error",
                  "not_found_error",
                  "rate_limit_error",
                  "server_error"
                ],
                "description": "Error category"
              }
            },
            "required": [
              "code",
              "message",
              "type"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "ModelsResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "enum": [
                    "gpro",
                    "gpro31",
                    "gpro38",
                    "orpheus",
                    "xai"
                  ]
                },
                "max_input_length": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "name": {
                  "type": "string"
                },
                "supported_formats": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "wav",
                      "mp3"
                    ]
                  }
                }
              },
              "required": [
                "id",
                "max_input_length",
                "name",
                "supported_formats"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "data"
        ],
        "additionalProperties": false
      },
      "VoiceGenerationResponse": {
        "type": "object",
        "properties": {
          "credits_remaining": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Remaining credits"
          },
          "credits_used": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Credits consumed for this generation"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "URL to generated audio"
          },
          "usage": {
            "type": "object",
            "properties": {
              "input_characters": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991,
                "description": "Input characters processed"
              },
              "model": {
                "type": "string",
                "description": "Model used for generation"
              }
            },
            "required": [
              "input_characters",
              "model"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "credits_remaining",
          "credits_used",
          "url",
          "usage"
        ],
        "additionalProperties": false
      },
      "VoicesResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "formats": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "wav",
                      "mp3"
                    ]
                  }
                },
                "id": {
                  "type": "string"
                },
                "language": {
                  "type": "string"
                },
                "model": {
                  "type": "string",
                  "enum": [
                    "gpro",
                    "gpro31",
                    "gpro38",
                    "orpheus",
                    "xai"
                  ]
                },
                "name": {
                  "type": "string"
                },
                "supports_style": {
                  "type": "boolean",
                  "description": "Whether this voice accepts the freeform `style` parameter"
                }
              },
              "required": [
                "formats",
                "id",
                "language",
                "model",
                "name",
                "supports_style"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "data"
        ],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "API Key",
        "scheme": "bearer",
        "type": "http"
      }
    }
  }
}
