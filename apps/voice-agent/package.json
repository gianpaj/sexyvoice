{
  "name": "@sexyvoice/voice-agent",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local src/agent.ts dev --log-level warn",
    "download-files": "node --env-file-if-exists=.env.local src/agent.ts download-files",
    "fixall": "biome check --write src tests",
    "start": "node --env-file-if-exists=.env.local src/agent.ts start --log-level warn",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@livekit/agents": "1.10.0",
    "@livekit/agents-plugin-inworld": "1.10.0",
    "@livekit/agents-plugin-openai": "1.10.0",
    "@livekit/agents-plugin-silero": "1.10.0",
    "@livekit/agents-plugin-xai": "1.10.0",
    "@livekit/rtc-node": "1.2.2",
    "@sexyvoice/voice-spike": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "4.1.11",
    "ws": "8.23.0"
  },
  "engines": {
    "node": "24.x"
  }
}
